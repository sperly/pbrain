	(text "PANEL SUPPORT PARTS (SSD1363 4-wire SPI reference circuit)"
		(exclude_from_sim no)
		(at 22.225 102.87 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3a3a5f74-b186-5e20-a4e0-d865985b4474")
	)
	(text "Place all of these next to the FPC connector. 25 V parts on VCC, VCOMH and VP."
		(exclude_from_sim no)
		(at 25.4 157.48 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "68d16de5-53cb-5dda-8714-0bf08803f8e3")
	)
	(text "BS1 = BS2 = 0: 4-wire SPI\nD0 = SCLK, D1+D2 = SDIN\n\nPin names start with the\nFPC pin number. Numbers\noutside the box are J5\npads: the tail folds behind\nthe board, so pad n mates\nFPC pin 31 - n.\n\nCHECK on the TCC panel:\n- pinout and flex length\n- contacts face the display\n  front (Midas drawing), so\n  J5 must be TOP contact"
		(exclude_from_sim no)
		(at 199.39 121.92 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "738e4647-b6e7-54b1-b10f-a1c6f889659b")
	)
	(text "VCC = 0.795 V x (1 + 1M/56k) = 15.0 V (panel: 14.5-15.5 V)\nEN low: output disconnected, VCC floats as the panel requires.\nSequence: +3V3 and init first, then EN high, 100 ms, display on.\nPanel draws about 53 mA at 50 % pixels on, 91 mA at 100 %."
		(exclude_from_sim no)
		(at 25.4 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "76f1ee72-fc93-5932-b614-a2f7f0c705c5")
	)
	(text "DNP: firmware selects\ninternal IREF (0xAD 0x90).\nFit only for external IREF."
		(exclude_from_sim no)
		(at 132.08 132.08 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "c08d8f11-f151-5514-a03d-4af549eb9f67")
	)
	(text "OLED PANEL SUPPLY: 15 V BOOST"
		(exclude_from_sim no)
		(at 22.225 31.75 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "fb1ee661-ef2b-5c55-8bd5-04c50e5e4a66")
	)

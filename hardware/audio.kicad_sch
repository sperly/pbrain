	(text "CLASS-D SPEAKER AMPLIFIER"
		(exclude_from_sim no)
		(at 144.145 41.91 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "03d88e03-e39e-5f8c-8694-3ae92ad6dcf7")
	)
	(text "AMP_EN drives SD_MODE: low = shutdown (internal 100k pull-down),\nhigh (3.3 V) = on, left slot. GAIN open = 9 dB.\nSupplied from VSYS (3.4-4.4 V) to keep speaker peaks off +3V3.\nFilterless output: keep the speaker leads short and twisted."
		(exclude_from_sim no)
		(at 147.32 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0aa3fb64-08cd-546c-90ea-4ba7b8779298")
	)
	(text "8 ohm miniature speaker"
		(exclude_from_sim no)
		(at 261.62 75.565 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "56937f56-dc5e-5038-8f48-41efcfd52ee3")
	)
	(text "I2S MEMS MICROPHONE"
		(exclude_from_sim no)
		(at 27.305 41.91 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "78e732ef-ebfc-52f1-bbbb-4fd8bb1a1fb7")
	)
	(text "SEL low = left slot. DATA is tri-stated in the\nother slot, 100k keeps the line defined.\nBottom port: needs a PCB hole and a sealed\nacoustic path, away from the speaker."
		(exclude_from_sim no)
		(at 30.48 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f9a30dac-cc1e-5757-a1c1-e4bbd24802b2")
	)

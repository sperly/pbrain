	(text "Mitsumi SIQ-02FVS3 (LCSC C2925423): 15 detents, dial overhangs\nthe board edge. A, B and PUSH all switch to COM.\nA is open at the detent; B changes state there, so decode on\nA edges and read B. If B rests closed, its pull-up draws 33 uA.\nPush switch is active low, RTC wake (IO16)."
		(exclude_from_sim no)
		(at 190.5 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cab10056-e235-5f05-8ced-1b68e0a85568")
	)
	(text "XKB TS-1101VS-B-A-A (LCSC C561499): side push, 160 gf,\nmetal cover grounded. Sits on the board edge, recessed,\nopposite the wheel. Active low, RTC wake (IO15)."
		(exclude_from_sim no)
		(at 30.48 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "eb5f84a1-0ca8-5086-b0c9-12c26924a577")
	)

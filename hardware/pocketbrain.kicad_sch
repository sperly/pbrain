				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "496a11f6-c9b6-5554-bcdc-b96a327f3756")
	)
	(text "System overview. Each block is one sheet. Power rails (VBUS, +BATT, VSYS, +3V3, +15V, GND) are global."

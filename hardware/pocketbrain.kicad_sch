	)
	(text "CHECK before PCB layout:\n1. OLED flex on the TCC panel:\n   pinout, length, contacts\n   facing the display front.\n2. Battery lead polarity\n   (J2: pin 1 = cell +).\n3. Fit-check Talk switch\n   (TS-1101VS) and wheel\n   (SIQ-02FVS3) in the shell;\n   both sit on a board edge.\n4. Wheel: B is undefined at\n   the detent. Decode on A\n   edges in firmware.\n5. Firmware: drive IO8 and\n   IO9, read IO1 / IO2 / IO21."
		(exclude_from_sim no)
		(at 134.62 138.43 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "35eabe0e-3f2c-56b1-8d00-f1da74a7875a")
	)
	(text "Reset\nBOOT\nVBAT_SENSE\nCHG_N\nI2S_BCLK\nI2S_WS\nI2S_MIC_DATA\nI2S_AMP_DATA\nAMP_EN\nOLED_VCC_EN\nOLED_CS_N\nOLED_MOSI\nOLED_SCLK\nOLED_DC\nOLED_RST_N\nTALK_N\nWHEEL_SW_N\nWHEEL_A\nWHEEL_B\nUSB_DN / USB_DP\nPGOOD_N\nUART_TX / UART_RX"
		(exclude_from_sim no)
		(at 43.18 138.43 0)

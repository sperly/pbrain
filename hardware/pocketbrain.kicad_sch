		(uuid "3ab53d22-26f0-5d01-b10e-30d7e8315957")
	)
	(text "RC + RESET button\nstrapping, BOOT button\nADC1_CH0, VBAT / 2\nlow = charging\nmic + amp\nmic + amp\nmic to MCU\nMCU to amp\nnew: PB_AMP_SD_PIN = 8\nnew: 15 V boost enable\n\n\n\n\n\nRTC wake\nRTC wake\n\n\nnative USB\nlow = USB power present\ndebug header"
		(exclude_from_sim no)
		(at 78.74 138.43 0)
